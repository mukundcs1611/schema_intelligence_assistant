# Copy to .env and adjust. Every value below has a working default in code --
# .env is for per-deployment tuning, not for making the project run.

# --- Models (local Ollama) ---
# Layer 2 classifier in pii-detector/detector.py
CLASSIFIER_MODEL=qwen2.5:7b
# Conversational agent in agent/agent.py. 7b, not 14b -- see
# agent/tests/ab_baseline_results.md for the measurements behind that choice.
AGENT_MODEL=qwen2.5:7b

# --- Confidence thresholds (see QUALITY_CRITERIA.md) ---
# A column detected as PII at or above this auto-configures; below it, review queue.
AUTO_CONFIGURE_THRESHOLD=0.80
# A column detected as NOT PII below this is still sent to review, rather than
# silently cleared, when the rule layer had no opinion to cross-check the LLM.
NEGATIVE_REVIEW_FLOOR=0.60

# --- Storage ---
# Audit trail of every detection decision. Defaults to ./audit_log.db
# AUDIT_DB_PATH=/var/lib/schema-intelligence/audit_log.db
